NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=petverse
DB_SYNCHRONIZE=true

# Production requires a unique value with at least 32 characters.
JWT_SECRET=petverse-development-secret-change-me

# Comma-separated web origins. WeChat wx.request does not use browser CORS.
CORS_ORIGINS=http://localhost:7456,http://127.0.0.1:7456

# Never enable this in production. It exists only for local regression scripts.
ALLOW_TEST_USER_HEADER=false

# Required when NODE_ENV=production. WX_SECRET must exist only on the server.
WX_APPID=
WX_SECRET=
